+int64_t Arm64JITCore::EmitBackedgeInterruptCheck(IR::OrderedNodeWrapper TargetBlock) {
+  if (!CTX->Config.NeedsPendingInterruptFaultCheck) {
+    return -1;
+  }
+  const auto Target = IR->GetOp<IR::IROp_CodeBlock>(TargetBlock);
+  if (!Target->EntryPoint && Target->GuestEntryOffset == 0) {
+    return -1;
+  }
+  const int64_t Prev = DebugData->GuestOpcodes.empty() ? 0 : DebugData->GuestOpcodes.back().GuestEntryOffset;
+  DebugData->GuestOpcodes.push_back({Target->GuestEntryOffset, GetCursorAddress<uint8_t*>() - CodeData.BlockBegin});
   EmitSuspendInterruptCheck();
+  return Prev;
+}
+
+void Arm64JITCore::EndBackedgeInterruptCheck(int64_t Prev) {
+  if (Prev >= 0) {
+    DebugData->GuestOpcodes.push_back({static_cast<uint64_t>(Prev), GetCursorAddress<uint8_t*>() - CodeData.BlockBegin});
+  }
 }
 
 
