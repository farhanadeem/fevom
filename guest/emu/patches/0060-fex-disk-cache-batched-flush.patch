+  void IndexedDB::StoreCacheBlobs(std::span<StoreRequest> Requests) {
+    for (auto& R : Requests) {
+      R.Stored = false;
+    }
+    if (ReadOnly || Requests.empty()) {
+      return;
+    }
+    auto& CacheFOZ = WriteCacheFOZ;
+    auto& IndexFOZ = WriteIndexFOZ;
+    if (!CacheFOZ.Lock(STORE_LOCK_TIMEOUT_MS) || !IndexFOZ.Lock(STORE_LOCK_TIMEOUT_MS)) {
+      CacheFOZ.Unlock();
+      IndexFOZ.Unlock();
+      return;
+    }
+    const ssize_t CacheEnd = CacheFOZ.Size();
+    const ssize_t IndexEnd = IndexFOZ.Size();
+    if (CacheEnd < 0 || IndexEnd < 0) {
+      CacheFOZ.Unlock();
+      IndexFOZ.Unlock();
+      return;
+    }
+
+    const auto Append = [](fextl::vector<uint8_t>& Out, const void* Data, size_t Size) {
+      const auto* P = static_cast<const uint8_t*>(Data);
+      Out.insert(Out.end(), P, P + Size);
+    };
+    size_t CacheBytes = 0, IndexBytes = 0;
+    for (const auto& R : Requests) {
+      CacheBytes += sizeof(MesaFOZ::foz_payload_key) + sizeof(MesaFOZ::foz_payload_header) + R.Blob.size();
+      IndexBytes += sizeof(MesaFOZ::foz_payload_key) + sizeof(MesaFOZ::foz_payload_header) + sizeof(MesaFOZ::mesa_index_db_file_entry) +
+                    R.IndexBlob.size();
+    }
+    fextl::vector<uint8_t> CacheBuf, IndexBuf;
+    CacheBuf.reserve(CacheBytes);
+    IndexBuf.reserve(IndexBytes);
+
+    for (auto& R : Requests) {
+      if (MaxSizeReached || (uint64_t)CacheEnd + CacheBuf.size() + R.Blob.size() >= MaxFileSize) {
+        MaxSizeReached = true;
+        break;
+      }
+      Append(CacheBuf, R.UniqueKey->bytes, sizeof(R.UniqueKey->bytes));
+      const MesaFOZ::foz_payload_header BlobHeader {.payload_size = (uint32_t)R.Blob.size(),
+                                                    .format = MesaFOZ::FOSSILIZE_COMPRESSION_NONE,
+                                                    .crc = 0,
+                                                    .uncompressed_size = (uint32_t)R.Blob.size()};
+      Append(CacheBuf, &BlobHeader, sizeof(BlobHeader));
+      const uint64_t BlobOffset = (uint64_t)CacheEnd + CacheBuf.size();
+      Append(CacheBuf, R.Blob.data(), R.Blob.size());
+
+      *R.IndexEntry = {.hash = R.LookupKey, .size = (uint32_t)R.Blob.size(), .last_access_time = 0, .cache_db_file_offset = BlobOffset};
+      const uint32_t IndexPayload = sizeof(MesaFOZ::mesa_index_db_file_entry) + R.IndexBlob.size();
+      Append(IndexBuf, R.UniqueKey->bytes, sizeof(R.UniqueKey->bytes));
+      const MesaFOZ::foz_payload_header IndexHeader {
+        .payload_size = IndexPayload, .format = MesaFOZ::FOSSILIZE_COMPRESSION_NONE, .crc = 0, .uncompressed_size = IndexPayload};
+      Append(IndexBuf, &IndexHeader, sizeof(IndexHeader));
+      Append(IndexBuf, R.IndexEntry, sizeof(*R.IndexEntry));
+      Append(IndexBuf, R.IndexBlob.data(), R.IndexBlob.size());
+      R.Stored = true;
+    }
+
+    bool Written = CacheBuf.empty() || CacheFOZ.PWriteAll(CacheBuf, CacheEnd);
+    Written = Written && (IndexBuf.empty() || IndexFOZ.PWriteAll(IndexBuf, IndexEnd));
+    CacheFOZ.Unlock();
+    IndexFOZ.Unlock();
+    if (!Written) {
+      for (auto& R : Requests) {
+        R.Stored = false;
+      }
+      return;
+    }
+    if (CacheFileMapping) {
+      CacheFileSize = (uint64_t)CacheEnd + CacheBuf.size();
+    }
+  }
