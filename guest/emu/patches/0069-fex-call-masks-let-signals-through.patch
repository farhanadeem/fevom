+uint64_t SignalDelegator::BeginCallMask(FEX::HLE::ThreadStateObject* Thread, uint64_t GuestMask) {
+  const uint64_t IgnoredSignalsMask = ~((1ULL << (SIGKILL - 1)) | (1ULL << (SIGSTOP - 1)));
+  Thread->SignalInfo.CallMask.Val = GuestMask & IgnoredSignalsMask;
+  Thread->SignalInfo.CallMaskActive = true;
+  return (Thread->SignalInfo.CallMask.Val | DeferredFrameSignals(Thread)) & ~RequiredSignalMask();
+}
+
+void SignalDelegator::EndCallMask(FEX::HLE::ThreadStateObject* Thread) {
+  Thread->SignalInfo.CallMaskActive = false;
+}
