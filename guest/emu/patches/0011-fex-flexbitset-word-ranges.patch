+  static T ElementMask(size_t Lo, size_t Hi) {
+    const T High = Hi == MinimumSizeBits ? ~T(0) : (T(1) << Hi) - 1;
+    return High & (~T(0) << Lo);
+  }
+
+  template<bool Value>
+  size_t FindFirst(size_t Lo, size_t Hi) const {
+    while (Lo < Hi) {
+      const size_t Index = Lo / MinimumSizeBits;
+      const size_t Base = Index * MinimumSizeBits;
+      const size_t End = Hi - Base < MinimumSizeBits ? Hi - Base : MinimumSizeBits;
+      T Bits = Value ? Memory[Index] : ~Memory[Index];
+      Bits &= ElementMask(Lo - Base, End);
+      if (Bits) {
+        return Base + std::countr_zero(Bits);
+      }
+      Lo = Base + MinimumSizeBits;
+    }
+    return ~0ULL;
+  }
+
+  template<bool Value>
+  size_t FindLast(size_t Lo, size_t Hi) const {
+    while (Hi > Lo) {
+      const size_t Index = (Hi - 1) / MinimumSizeBits;
+      const size_t Base = Index * MinimumSizeBits;
+      const size_t Begin = Lo > Base ? Lo - Base : 0;
+      T Bits = Value ? Memory[Index] : ~Memory[Index];
+      Bits &= ElementMask(Begin, Hi - Base);
+      if (Bits) {
+        return Base + (MinimumSizeBits - 1 - std::countl_zero(Bits));
+      }
+      Hi = Base;
+    }
+    return ~0ULL;
+  }
+
+  size_t SetRange(size_t Begin, size_t Count) {
+    size_t Changed = 0;
+    for (size_t Lo = Begin, Hi = Begin + Count; Lo < Hi;) {
+      const size_t Index = Lo / MinimumSizeBits;
+      const size_t Base = Index * MinimumSizeBits;
+      const size_t End = Hi - Base < MinimumSizeBits ? Hi - Base : MinimumSizeBits;
+      const T Mask = ElementMask(Lo - Base, End);
+      Changed += std::popcount(T(~Memory[Index] & Mask));
+      Memory[Index] |= Mask;
+      Lo = Base + End;
+    }
+    return Changed;
+  }
+
+  size_t ClearRange(size_t Begin, size_t Count) {
+    size_t Changed = 0;
+    for (size_t Lo = Begin, Hi = Begin + Count; Lo < Hi;) {
+      const size_t Index = Lo / MinimumSizeBits;
+      const size_t Base = Index * MinimumSizeBits;
+      const size_t End = Hi - Base < MinimumSizeBits ? Hi - Base : MinimumSizeBits;
+      const T Mask = ElementMask(Lo - Base, End);
+      Changed += std::popcount(T(Memory[Index] & Mask));
+      Memory[Index] &= ~Mask;
+      Lo = Base + End;
+    }
+    return Changed;
+  }
