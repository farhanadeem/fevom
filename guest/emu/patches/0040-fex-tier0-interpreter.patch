+Step One(IState& s, u64& rip) {
+  Dec d;
+  d.P = reinterpret_cast<const u8*>(rip);
+  d.Rex = 0;
+  d.Rep = 0;
+  d.Seg = 0;
+  d.Op16 = false;
+  d.Lock = false;
+  d.Addr32 = false;
+  u64* R = s.R;
+  u8 op;
+  for (;;) {
+    op = *d.P++;
+    switch (op) {
+    case 0x66: d.Op16 = true; d.Rex = 0; continue;
+    case 0xF0: d.Lock = true; d.Rex = 0; continue;
+    case 0xF2:
+    case 0xF3: d.Rep = op; d.Rex = 0; continue;
+    case 0x2E:
+    case 0x3E:
+    case 0x26:
+    case 0x36: d.Rex = 0; continue;
+    case 0x64:
+    case 0x65: d.Seg = op; d.Rex = 0; continue;
+    case 0x67: d.Addr32 = true; d.Rex = 0; continue;
+    case 0x40 ... 0x4F: d.Rex = op; continue;
