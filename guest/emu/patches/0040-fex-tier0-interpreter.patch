+using Slot = std::atomic<u64>;
+constexpr u64 TableBits = 22, BucketBits = 9;
+constexpr u64 TableSize = 1ull << TableBits;
+Slot* Table = nullptr;
+constexpr u64 COUNT_MASK = 0x7fff, COMPILED_BIT = 0x8000;
