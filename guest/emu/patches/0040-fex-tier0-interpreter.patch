+#pragma clang section text = "fex_tier0"
+namespace {
+#define AI __attribute__((always_inline)) inline
+#define AI_LAMBDA __attribute__((always_inline))
+
+AI u64 SizeMask(unsigned s) {
+  return s == 8 ? ~0ull : ((1ull << (s * 8)) - 1);
+}
+AI u64 SignBit(unsigned s) {
+  return 1ull << (s * 8 - 1);
+}
+AI u64 SExt(u64 v, unsigned s) {
+  switch (s) {
+  case 1: return (u64)(s64)(s8)v;
+  case 2: return (u64)(s64)(s16)v;
+  case 4: return (u64)(s64)(s32)v;
+  default: return v;
+  }
+}
+AI u32 Parity(u64 r) {
+  return (std::popcount((unsigned)(r & 0xff)) & 1) ? 0 : F_PF;
+}
+AI u32 ZSP(u64 r, unsigned s) {
+  return ((r & SizeMask(s)) == 0 ? F_ZF : 0) | ((r & SignBit(s)) ? F_SF : 0) | Parity(r);
+}
+
+u32 Materialize(const Lazy& L) {
+  const unsigned s = L.Size;
+  const u64 m = SizeMask(s), sb = SignBit(s);
+  const u64 a = L.A & m, b = L.B & m, r = L.Res & m;
+  switch (L.Op) {
+  case L_MAT: return L.Mat;
+  case L_ADD:
+  case L_ADC: {
+    u32 f = ZSP(r, s);
+    if (L.Op == L_ADC && L.Cin ? r <= a : r < a) f |= F_CF;
+    if ((a ^ r) & (b ^ r) & sb) f |= F_OF;
+    if ((a ^ b ^ r) & 0x10) f |= F_AF;
+    return f;
+  }
+  case L_SUB:
+  case L_SBB: {
+    u32 f = ZSP(r, s);
+    if (L.Op == L_SBB && L.Cin ? a <= b : a < b) f |= F_CF;
+    if ((a ^ b) & (a ^ r) & sb) f |= F_OF;
+    if ((a ^ b ^ r) & 0x10) f |= F_AF;
+    return f;
+  }
+  case L_LOGIC: return ZSP(r, s);
+  case L_INC: return (L.Mat & F_CF) | ZSP(r, s) | (r == sb ? F_OF : 0) | (((a ^ r) & 0x10) ? F_AF : 0);
+  case L_DEC: return (L.Mat & F_CF) | ZSP(r, s) | (a == sb ? F_OF : 0) | (((a ^ r) & 0x10) ? F_AF : 0);
+  }
+  return 0;
+}
+
+AI void SetMat(IState& s, u32 f) {
+  s.F.Op = L_MAT;
+  s.F.Mat = f;
+}
+AI void SetLazy(IState& s, LazyOp Op, unsigned Size, u64 A, u64 B, u64 Res) {
+  s.F.Op = Op;
+  s.F.Size = Size;
+  s.F.A = A;
+  s.F.B = B;
+  s.F.Res = Res;
+}
+AI u32 Flags(const IState& s) {
+  return s.F.Op == L_MAT ? s.F.Mat : Materialize(s.F);
+}
+AI u32 CF(const IState& s) {
+  return Flags(s) & F_CF;
+}
+
+AI bool Cond(u32 f, unsigned cc) {
+  bool r;
+  switch (cc >> 1) {
+  case 0: r = f & F_OF; break;
+  case 1: r = f & F_CF; break;
+  case 2: r = f & F_ZF; break;
+  case 3: r = f & (F_CF | F_ZF); break;
+  case 4: r = f & F_SF; break;
+  case 5: r = f & F_PF; break;
+  case 6: r = !!(f & F_SF) != !!(f & F_OF); break;
+  default: r = (f & F_ZF) || (!!(f & F_SF) != !!(f & F_OF)); break;
+  }
+  return (cc & 1) ? !r : r;
+}
+
+template<typename T>
+AI T Ld(u64 a) {
+  T v;
+  __builtin_memcpy(&v, reinterpret_cast<const void*>(a), sizeof(T));
+  return v;
+}
+template<typename T>
+AI void Stv(u64 a, T v) {
+  __builtin_memcpy(reinterpret_cast<void*>(a), &v, sizeof(T));
+}
+AI u64 LdN(u64 a, unsigned s) {
+  switch (s) {
+  case 1: return Ld<u8>(a);
+  case 2: return Ld<u16>(a);
+  case 4: return Ld<u32>(a);
+  default: return Ld<u64>(a);
+  }
+}
+AI void StN(u64 a, unsigned s, u64 v) {
+  switch (s) {
+  case 1: Stv<u8>(a, (u8)v); break;
+  case 2: Stv<u16>(a, (u16)v); break;
+  case 4: Stv<u32>(a, (u32)v); break;
+  default: Stv<u64>(a, v); break;
+  }
+}
+AI bool CasN(u64 a, unsigned s, u64& Old, u64 New) {
+  switch (s) {
+  case 1: {
+    u8 o = (u8)Old;
+    bool ok = __atomic_compare_exchange_n(reinterpret_cast<u8*>(a), &o, (u8)New, false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);
+    Old = o;
+    return ok;
+  }
+  case 2: {
+    u16 o = (u16)Old;
+    bool ok = __atomic_compare_exchange_n(reinterpret_cast<u16*>(a), &o, (u16)New, false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);
+    Old = o;
+    return ok;
+  }
+  case 4: {
+    u32 o = (u32)Old;
+    bool ok = __atomic_compare_exchange_n(reinterpret_cast<u32*>(a), &o, (u32)New, false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);
+    Old = o;
+    return ok;
+  }
+  default: {
+    u64 o = Old;
+    bool ok = __atomic_compare_exchange_n(reinterpret_cast<u64*>(a), &o, New, false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);
+    Old = o;
+    return ok;
+  }
+  }
+}
+AI u64 XchgN(u64 a, unsigned s, u64 v) {
+  switch (s) {
+  case 1: return __atomic_exchange_n(reinterpret_cast<u8*>(a), (u8)v, __ATOMIC_SEQ_CST);
+  case 2: return __atomic_exchange_n(reinterpret_cast<u16*>(a), (u16)v, __ATOMIC_SEQ_CST);
+  case 4: return __atomic_exchange_n(reinterpret_cast<u32*>(a), (u32)v, __ATOMIC_SEQ_CST);
+  default: return __atomic_exchange_n(reinterpret_cast<u64*>(a), v, __ATOMIC_SEQ_CST);
+  }
+}
