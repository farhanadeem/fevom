+    }
+    if ((OffMask & OFF_ATOMIC) && (d.Lock || op == 0x86 || op == 0x87)) {
+      return STOP;
+    }
+    if ((OffMask & OFF_SHIFT) && (op == 0xC0 || op == 0xC1 || (op >= 0xD0 && op <= 0xD3))) {
+      return STOP;
+    }
+    if ((OffMask & OFF_MULDIV) && (op == 0x69 || op == 0x6B)) {
+      return STOP;
+    }
