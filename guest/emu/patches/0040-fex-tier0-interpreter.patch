+AI unsigned OpSize(const Dec& d) {
+  return (d.Rex & 8) ? 8 : d.Op16 ? 2 : 4;
+}
+
+AI u64 GetReg(const IState& s, unsigned r, unsigned size, u8 rex) {
+  if (size == 1) {
+    if (!rex && r >= 4 && r < 8) {
+      return (s.R[r - 4] >> 8) & 0xff;
+    }
+    return s.R[r] & 0xff;
+  }
+  return s.R[r] & SizeMask(size);
+}
+AI void SetReg(IState& s, unsigned r, unsigned size, u8 rex, u64 v) {
+  switch (size) {
+  case 8: s.R[r] = v; break;
+  case 4: s.R[r] = (u32)v; break;
+  case 2: s.R[r] = (s.R[r] & ~0xffffull) | (v & 0xffff); break;
+  default:
+    if (!rex && r >= 4 && r < 8) {
+      s.R[r - 4] = (s.R[r - 4] & ~0xff00ull) | ((v & 0xff) << 8);
+    } else {
+      s.R[r] = (s.R[r] & ~0xffull) | (v & 0xff);
+    }
+    break;
+  }
+}
