+enum Step : int { NEXT, BRANCH, STOP };
+
+constexpr u32 F_CF = 1u << 0, F_PF = 1u << 2, F_AF = 1u << 4, F_ZF = 1u << 6, F_SF = 1u << 7, F_OF = 1u << 11;
+enum LazyOp : u8 { L_MAT, L_ADD, L_ADC, L_SUB, L_SBB, L_LOGIC, L_INC, L_DEC };
+struct Lazy {
+  u64 A, B, Res;
+  u8 Op, Size, Cin, Pad;
+  u32 Mat;
+};
+
+struct IState {
+  Lazy F;
+  Lazy FStart;
+  u64 RIPStart;
+  u64 Ran;
+  Core::CPUState* S;
+  u64* R;
+  u64 (*X)[2];
+  u64 CRBase;
+};
+static_assert(sizeof(IState) <= sizeof(((Core::InternalThreadState*)nullptr)->Tier0Scratch));
+
+u32 ReadFlags(const Core::CPUState& S) {
+  u32 nzcv;
+  memcpy(&nzcv, &S.flags[X86State::RFLAG_NZCV_LOC], 4);
+  u32 f = 0;
+  if (nzcv & (1u << 28)) f |= F_OF;
+  if (!(nzcv & (1u << 29))) f |= F_CF;
+  if (nzcv & (1u << 30)) f |= F_ZF;
+  if (nzcv & (1u << 31)) f |= F_SF;
+  const u32 pfb = S.pf_raw & 0xff;
+  if (std::popcount(pfb ^ 1) & 1) f |= F_PF;
+  if ((S.af_raw ^ pfb) & 0x10) f |= F_AF;
+  return f;
+}
+
+void WriteFlags(Core::CPUState& S, u32 f) {
+  u32 nzcv = 0;
+  if (f & F_OF) nzcv |= 1u << 28;
+  if (!(f & F_CF)) nzcv |= 1u << 29;
+  if (f & F_ZF) nzcv |= 1u << 30;
+  if (f & F_SF) nzcv |= 1u << 31;
+  memcpy(&S.flags[X86State::RFLAG_NZCV_LOC], &nzcv, 4);
+  const u32 pfb = (f & F_PF) ? 0 : 1;
+  S.pf_raw = pfb;
+  S.af_raw = pfb ^ ((f & F_AF) ? 0x10 : 0);
+}
