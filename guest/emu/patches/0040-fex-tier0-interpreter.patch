+struct Dec {
+  const u8* P;
+  u8 Rex;
+  u8 Rep;
+  u8 Seg;
+  bool Addr32;
+  bool Op16;
+  bool Lock;
+  u8 Mod, Reg, RM;
+  bool Mem, RipRel;
+  s64 Disp;
+  u64 EA;
+};
