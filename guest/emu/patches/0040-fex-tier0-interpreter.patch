+AI void ModRM(const IState& s, Dec& d) {
+  const u8 m = *d.P++;
+  d.Mod = m >> 6;
+  d.Reg = ((m >> 3) & 7) | ((d.Rex & 4) << 1);
+  const u8 rm = m & 7;
+  if (d.Mod == 3) {
+    d.Mem = false;
+    d.RM = rm | ((d.Rex & 1) << 3);
+    return;
+  }
+  d.Mem = true;
+  d.RipRel = false;
+  u64 ea = 0;
+  if (rm == 4) {
+    const u8 sib = *d.P++;
+    const unsigned idx = ((sib >> 3) & 7) | ((d.Rex & 2) << 2);
+    if (idx != 4) {
+      ea += s.R[idx] << (sib >> 6);
+    }
+    if ((sib & 7) == 5 && d.Mod == 0) {
+      ea += (u64)(s64)Ld<s32>((u64)d.P);
+      d.P += 4;
+    } else {
+      ea += s.R[(sib & 7) | ((d.Rex & 1) << 3)];
+    }
+  } else if (rm == 5 && d.Mod == 0) {
+    d.RipRel = true;
+    d.Disp = Ld<s32>((u64)d.P);
+    d.P += 4;
+  } else {
+    ea += s.R[rm | ((d.Rex & 1) << 3)];
+  }
+  if (d.Mod == 1) {
+    ea += (u64)(s64)(s8)*d.P++;
+  } else if (d.Mod == 2) {
+    ea += (u64)(s64)Ld<s32>((u64)d.P);
+    d.P += 4;
+  }
+  d.EA = ea;
+}
+AI void FinishEA(const IState& s, Dec& d, bool Seg = true) {
+  if (!d.Mem) {
+    return;
+  }
+  if (d.RipRel) {
+    d.EA = (u64)d.P + d.Disp;
+  }
+  if (d.Addr32) {
+    d.EA = (u32)d.EA;
+  }
+  if (Seg) {
+    if (d.Seg == 0x64) {
+      d.EA += s.S->fs_cached;
+    } else if (d.Seg == 0x65) {
+      d.EA += s.S->gs_cached;
+    }
+  }
+}
+AI u64 GetRM(const IState& s, const Dec& d, unsigned size) {
+  return d.Mem ? LdN(d.EA, size) : GetReg(s, d.RM, size, d.Rex);
+}
+AI void SetRM(IState& s, const Dec& d, unsigned size, u64 v) {
+  if (d.Mem) {
+    StN(d.EA, size, v);
+  } else {
+    SetReg(s, d.RM, size, d.Rex, v);
+  }
+}
+AI u64 Imm(Dec& d, unsigned size) {
+  switch (size) {
+  case 1: {
+    u64 v = (u64)(s64)(s8)*d.P;
+    d.P += 1;
+    return v;
+  }
+  case 2: {
+    u64 v = (u64)(s64)Ld<s16>((u64)d.P);
+    d.P += 2;
+    return v;
+  }
+  default: {
+    u64 v = (u64)(s64)Ld<s32>((u64)d.P);
+    d.P += 4;
+    return v;
+  }
+  }
+}
+
+AI u64 AluCalc(Lazy& F, unsigned op, unsigned size, u64 a, u64 b, u32 cin) {
+  u64 r;
+  LazyOp k;
+  switch (op) {
+  case 0: r = a + b; k = L_ADD; break;
+  case 1: r = a | b; k = L_LOGIC; break;
+  case 2: r = a + b + cin; k = L_ADC; break;
+  case 3: r = a - b - cin; k = L_SBB; break;
+  case 4: r = a & b; k = L_LOGIC; break;
+  case 6: r = a ^ b; k = L_LOGIC; break;
+  default: r = a - b; k = L_SUB; break;
+  }
+  F.Op = k;
+  F.Size = size;
+  F.A = a;
+  F.B = b;
+  F.Res = r;
+  F.Cin = cin;
+  return r;
+}
+AI u64 Alu(IState& s, unsigned op, unsigned size, u64 a, u64 b, u32 cin) {
+  return AluCalc(s.F, op, size, a, b, cin);
+}
+
+AI void AluRM(IState& s, const Dec& d, unsigned op, unsigned size, u64 b) {
+  const u32 cin = (op == 2 || op == 3) ? CF(s) : 0;
+  Lazy F = s.F;
+  if (d.Mem && d.Lock && op != 7) {
+    u64 old = LdN(d.EA, size);
+    for (;;) {
+      const u64 r = AluCalc(F, op, size, old, b, cin);
+      if (CasN(d.EA, size, old, r)) {
+        break;
+      }
+    }
+    s.F = F;
+    return;
+  }
+  const u64 a = GetRM(s, d, size);
+  const u64 r = AluCalc(F, op, size, a, b, cin);
+  if (op != 7) {
+    SetRM(s, d, size, r);
+  }
+  s.F = F;
+}
+
+AI void ShadowCall(IState& s) {
+  constexpr u64 Size = Core::InternalThreadState::CALLRET_STACK_SIZE;
+  u64 sp = s.S->callret_sp - 16;
+  if (sp < s.CRBase + 16 || sp > s.CRBase + Size - 16) {
+    sp = s.CRBase + Size / 2;
+  }
+  Stv<u64>(sp, 0);
+  Stv<u64>(sp + 8, 0);
+  s.S->callret_sp = sp;
+}
+AI void ShadowRet(IState& s) {
+  constexpr u64 Size = Core::InternalThreadState::CALLRET_STACK_SIZE;
+  u64 sp = s.S->callret_sp + 16;
+  if (sp < s.CRBase + 16 || sp > s.CRBase + Size - 16) {
+    sp = s.CRBase + Size / 2;
+  }
+  s.S->callret_sp = sp;
+}
+
+AI void Push(IState& s, u64 v) {
+  const u64 sp = s.R[X86State::REG_RSP] - 8;
+  Stv<u64>(sp, v);
+  s.R[X86State::REG_RSP] = sp;
+}
