+  case 0x99: {
+    const unsigned size = OpSize(d);
+    SetReg(s, X86State::REG_RDX, size, d.Rex, (R[0] & SignBit(size)) ? ~0ull : 0);
+    rip = (u64)d.P;
+    return NEXT;
+  }
+  case 0xA4 ... 0xA7:
+  case 0xAA ... 0xAF: return String(s, d, op, rip);
+  case 0xA8:
+  case 0xA9: {
+    const unsigned size = op == 0xA8 ? 1 : OpSize(d);
+    const u64 b = Imm(d, size == 8 ? 4 : size);
+    const u64 a = GetReg(s, 0, size, d.Rex);
+    SetLazy(s, L_LOGIC, size, a, b, a & b);
+    rip = (u64)d.P;
+    return NEXT;
+  }
+  case 0xB0 ... 0xB7: {
+    const u64 v = *d.P++;
+    SetReg(s, (op & 7) | ((d.Rex & 1) << 3), 1, d.Rex, v);
+    rip = (u64)d.P;
+    return NEXT;
+  }
+  case 0xB8 ... 0xBF: {
+    const unsigned r = (op & 7) | ((d.Rex & 1) << 3);
+    if (d.Rex & 8) {
+      R[r] = Ld<u64>((u64)d.P);
+      d.P += 8;
+    } else {
+      const unsigned size = OpSize(d);
+      SetReg(s, r, size, d.Rex, Imm(d, size));
+    }
+    rip = (u64)d.P;
+    return NEXT;
+  }
+  case 0xC0:
+  case 0xC1:
+  case 0xD0:
+  case 0xD1:
+  case 0xD2:
+  case 0xD3: {
+    ModRM(s, d);
+    const unsigned size = (op & 1) ? OpSize(d) : 1;
+    unsigned cnt;
+    if (op <= 0xC1) {
+      cnt = *d.P++;
+    } else if (op <= 0xD1) {
+      cnt = 1;
+    } else {
+      cnt = (unsigned)R[X86State::REG_RCX];
+    }
+    FinishEA(s, d);
+    if (d.Lock || !Shift(s, d, size, cnt)) {
+      return STOP;
+    }
+    rip = (u64)d.P;
+    return NEXT;
+  }
+  case 0xC2:
+  case 0xC3: {
+    if (d.Op16) {
+      return STOP;
+    }
+    const u64 t = Ld<u64>(R[X86State::REG_RSP]);
+    u64 extra = 0;
+    if (op == 0xC2) {
+      extra = Ld<u16>((u64)d.P);
+      d.P += 2;
+    }
+    R[X86State::REG_RSP] += 8 + extra;
+    if (s.CRBase && !(OffMask & OFF_SHADOW)) {
+      ShadowRet(s);
+    }
+    rip = t;
+    return BRANCH;
+  }
+  case 0xC6:
+  case 0xC7: {
+    ModRM(s, d);
+    if ((d.Reg & 7) != 0) {
+      return STOP;
+    }
+    const unsigned size = op == 0xC6 ? 1 : OpSize(d);
+    const u64 v = Imm(d, size == 8 ? 4 : size);
+    FinishEA(s, d);
+    SetRM(s, d, size, v);
+    rip = (u64)d.P;
+    return NEXT;
+  }
+  case 0xC9: {
+    const u64 v = Ld<u64>(R[X86State::REG_RBP]);
+    R[X86State::REG_RSP] = R[X86State::REG_RBP] + 8;
+    R[X86State::REG_RBP] = v;
+    rip = (u64)d.P;
+    return NEXT;
+  }
+  case 0xE8: {
+    const u64 disp = Imm(d, 4);
+    const u64 next = (u64)d.P;
+    Push(s, next);
+    if (s.CRBase && !(OffMask & OFF_SHADOW)) {
+      ShadowCall(s);
+    }
+    rip = next + disp;
+    return BRANCH;
+  }
+  case 0xE9: {
+    const u64 disp = Imm(d, 4);
+    rip = (u64)d.P + disp;
+    return BRANCH;
+  }
+  case 0xEB: {
+    const u64 disp = Imm(d, 1);
+    rip = (u64)d.P + disp;
+    return BRANCH;
+  }
+  case 0xF5: SetMat(s, Flags(s) ^ F_CF); rip = (u64)d.P; return NEXT;
+  case 0xF8: SetMat(s, Flags(s) & ~F_CF); rip = (u64)d.P; return NEXT;
+  case 0xF9: SetMat(s, Flags(s) | F_CF); rip = (u64)d.P; return NEXT;
+  case 0xFC: s.S->flags[X86State::RFLAG_DF_RAW_LOC] = 1; rip = (u64)d.P; return NEXT;
+  case 0xFD: s.S->flags[X86State::RFLAG_DF_RAW_LOC] = 0xff; rip = (u64)d.P; return NEXT;
+  case 0xF6:
+  case 0xF7: {
+    ModRM(s, d);
+    const unsigned size = op == 0xF6 ? 1 : OpSize(d);
+    const unsigned k = d.Reg & 7;
+    if (k == 0 || k == 1) {
+      const u64 b = Imm(d, size == 8 ? 4 : size);
+      FinishEA(s, d);
+      const u64 a = GetRM(s, d, size);
+      SetLazy(s, L_LOGIC, size, a, b, a & b);
+      rip = (u64)d.P;
+      return NEXT;
+    }
+    FinishEA(s, d);
+    if (d.Lock) {
+      return STOP;
+    }
+    const u64 m = SizeMask(size);
+    const u64 v = GetRM(s, d, size) & m;
+    switch (k) {
+    case 2: SetRM(s, d, size, ~v); break;
+    case 3: {
+      SetRM(s, d, size, (0 - v) & m);
+      SetLazy(s, L_SUB, size, 0, v, 0 - v);
+      break;
+    }
+    case 4:
+    case 5: {
+      const unsigned bits = size * 8;
+      u64 lo, hi;
+      bool ovf;
+      if (k == 4) {
+        const unsigned __int128 p = (unsigned __int128)(GetReg(s, 0, size, d.Rex) & m) * v;
+        lo = (u64)p & m;
+        hi = (u64)(p >> bits) & m;
+        ovf = hi != 0;
+      } else {
+        const __int128 p = (__int128)(s64)SExt(GetReg(s, 0, size, d.Rex), size) * (s64)SExt(v, size);
+        lo = (u64)p & m;
+        hi = (u64)(p >> bits) & m;
+        ovf = (__int128)(s64)SExt(lo, size) != p;
+      }
+      if (size == 1) {
+        SetReg(s, 0, 2, d.Rex, lo | (hi << 8));
+      } else {
+        SetReg(s, 0, size, d.Rex, lo);
+        SetReg(s, X86State::REG_RDX, size, d.Rex, hi);
+      }
+      SetMat(s, ZSP(lo, size) | (ovf ? (F_CF | F_OF) : 0));
+      break;
+    }
+    default: {
+      if (v == 0 || size == 1) {
+        return STOP;
+      }
+      const unsigned bits = size * 8;
+      if (k == 6) {
+        const unsigned __int128 n = ((unsigned __int128)(GetReg(s, X86State::REG_RDX, size, d.Rex) & m) << bits) | (GetReg(s, 0, size, d.Rex) & m);
+        const unsigned __int128 q = n / v;
+        if (q > m) {
+          return STOP;
+        }
+        SetReg(s, 0, size, d.Rex, (u64)q);
+        SetReg(s, X86State::REG_RDX, size, d.Rex, (u64)(n % v));
+      } else {
+        const __int128 n = (__int128)(((unsigned __int128)(GetReg(s, X86State::REG_RDX, size, d.Rex) & m) << bits) |
+                                      (GetReg(s, 0, size, d.Rex) & m));
+        const __int128 sn = size == 8 ? n : (__int128)((s64)((u64)n << (64 - 2 * bits)) >> (64 - 2 * bits));
+        const s64 dv = (s64)SExt(v, size);
+        if (dv == -1) {
+          return STOP;
+        }
+        const __int128 q = sn / dv;
+        const s64 lo = size == 8 ? INT64_MIN : -(1ll << (bits - 1)), hi = size == 8 ? INT64_MAX : (1ll << (bits - 1)) - 1;
+        if (q < lo || q > hi) {
+          return STOP;
+        }
+        SetReg(s, 0, size, d.Rex, (u64)q);
+        SetReg(s, X86State::REG_RDX, size, d.Rex, (u64)(sn % dv));
+      }
+      break;
+    }
+    }
+    rip = (u64)d.P;
+    return NEXT;
+  }
+  case 0xFE:
+  case 0xFF: {
+    ModRM(s, d);
+    FinishEA(s, d);
+    const unsigned k = d.Reg & 7;
+    if (op == 0xFE && k > 1) {
+      return STOP;
+    }
+    if (k <= 1) {
+      const unsigned size = op == 0xFE ? 1 : OpSize(d);
+      const u32 cf = CF(s);
+      if (d.Mem && d.Lock) {
+        u64 old = LdN(d.EA, size);
+        while (!CasN(d.EA, size, old, k == 0 ? old + 1 : old - 1)) {
+        }
+        SetLazy(s, k == 0 ? L_INC : L_DEC, size, old, 1, k == 0 ? old + 1 : old - 1);
+      } else {
+        const u64 a = GetRM(s, d, size);
+        const u64 r = k == 0 ? a + 1 : a - 1;
+        SetRM(s, d, size, r);
+        SetLazy(s, k == 0 ? L_INC : L_DEC, size, a, 1, r);
+      }
+      s.F.Mat = cf;
+      rip = (u64)d.P;
+      return NEXT;
+    }
+    if (d.Op16) {
+      return STOP;
+    }
+    switch (k) {
+    case 2: {
+      const u64 t = GetRM(s, d, 8);
+      Push(s, (u64)d.P);
+      if (s.CRBase && !(OffMask & OFF_SHADOW)) {
+        ShadowCall(s);
+      }
+      rip = t;
+      return BRANCH;
+    }
+    case 4: {
+      rip = GetRM(s, d, 8);
+      return BRANCH;
+    }
+    case 6: {
+      Push(s, GetRM(s, d, 8));
+      rip = (u64)d.P;
+      return NEXT;
+    }
+    default: return STOP;
+    }
+  }
+  default: return STOP;
+  }
+}
+
+constexpr unsigned MaxBlockInsts = 4096;
+
+Step Block(IState& s, u64& rip, u64& insts) {
+  for (unsigned n = 0; n < MaxBlockInsts; n++) {
+    s.RIPStart = rip;
+    __asm__ volatile("" ::: "memory");
+    const Step r = One(s, rip);
+    if (r == STOP) {
+      rip = s.RIPStart;
+      return STOP;
+    }
+    s.Ran = 1;
+    insts++;
+    if (r == BRANCH) {
+      return BRANCH;
+    }
+  }
+  return BRANCH;
+}
+
+constexpr unsigned Probes = 512;
+AI Slot* ProbeTable(u64 RIP, bool Insert) {
+  Slot* Tab = Table;
+  const u64 Bucket = (((RIP >> 12) * 0x9E3779B97F4A7C15ull) >> (64 - (TableBits - BucketBits))) << BucketBits;
+  const u64 First = (RIP >> 3) & ((1ull << BucketBits) - 1);
+  for (unsigned probe = 0; probe < Probes; probe++) {
+    Slot& Sl = Tab[(Bucket + First + probe) & (TableSize - 1)];
+    u64 v = Sl.load(std::memory_order_relaxed);
+    if (v == 0) {
+      if (!Insert) {
+        return nullptr;
+      }
+      if (Sl.compare_exchange_strong(v, RIP << 16, std::memory_order_relaxed)) {
+        return &Sl;
+      }
+    }
+    if ((v >> 16) == RIP) {
+      return &Sl;
+    }
+  }
+  return nullptr;
+}
+AI Slot* FindSlot(u64 RIP) {
+  return ProbeTable(RIP, true);
+}
+AI u32 Bump(Slot* Sl, u32 W = 1) {
+  if (!Sl) {
+    return ~0u;
+  }
+  u64 v = Sl->load(std::memory_order_relaxed);
+  u64 n;
+  do {
+    const u64 c = v & COUNT_MASK;
+    n = (v & ~COUNT_MASK) | (c + W > COUNT_MASK ? COUNT_MASK : c + W);
+  } while (n != v && !Sl->compare_exchange_weak(v, n, std::memory_order_relaxed));
+  return (u32)n & 0xffff;
+}
+}
+#pragma clang section text = ""
+
+uint32_t Threshold() {
+  if (ThresholdValue == ~0u) {
+    InitOnce();
+  }
+  return ThresholdValue;
+}
+
+namespace {
+bool NewTable() {
+  if (__atomic_load_n(&Table, __ATOMIC_ACQUIRE)) {
+    return true;
+  }
+  const size_t Bytes = TableSize * sizeof(Slot);
+  void* p = mmap(nullptr, Bytes, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+  if (p == MAP_FAILED) {
+    return false;
+  }
+  madvise(p, Bytes, MADV_NOHUGEPAGE);
+  Slot* Expected = nullptr;
+  if (!__atomic_compare_exchange_n(&Table, &Expected, static_cast<Slot*>(p), false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+    munmap(p, Bytes);
+  }
+  return true;
+}
+}
+
+void MarkCompiled(uint64_t RIP) {
+  if (!__atomic_load_n(&Table, __ATOMIC_ACQUIRE)) {
+    return;
+  }
+  if (Slot* Sl = FindSlot(RIP)) {
+    Sl->fetch_or(COMPILED_BIT, std::memory_order_relaxed);
+  }
+}
+
+bool SeenFilter() {
+  return SeenFilterOn;
+}
+bool AllEntries() {
+  return AllEntriesOn;
+}
+
+bool Seen(uint64_t RIP) {
+  if (!__atomic_load_n(&Table, __ATOMIC_ACQUIRE)) {
+    return false;
+  }
+  Slot* Sl = ProbeTable(RIP, false);
+  return Sl && (Sl->load(std::memory_order_relaxed) & COUNT_MASK) != 0;
+}
+
+bool IsTier0PC(uint64_t PC) {
+  return __start_fex_tier0 && PC >= reinterpret_cast<uint64_t>(__start_fex_tier0) && PC < reinterpret_cast<uint64_t>(__stop_fex_tier0);
+}
+
+Result Run(FEXCore::Context::ContextImpl* CTX, FEXCore::Core::InternalThreadState* Thread, uint64_t RIP) {
+  const uint32_t T = Threshold();
+  if (!Table && !NewTable()) {
+    return {0, RIP, false};
+  }
+  if (St) {
+    St->Calls++;
+  }
+
+  Slot* FirstSlot = FindSlot(RIP);
+  if (!FirstSlot && St) {
+    St->Full++;
+  }
+  const u32 First = Bump(FirstSlot, EntryWeight) & COUNT_MASK;
+  if (First > T) {
+    if (St) {
+      St->Hot++;
+    }
+    return {0, RIP, false};
+  }
+
+  auto& S = Thread->CurrentFrame->State;
+  IState& s = *reinterpret_cast<IState*>(Thread->Tier0Scratch);
+  s.S = &S;
+  s.R = S.gregs;
+  s.X = CTX->HostFeatures.SupportsSVE256 ? nullptr : S.xmm.sse.data;
+  s.CRBase = reinterpret_cast<u64>(Thread->CallRetStackBase);
+  s.F.Op = L_MAT;
+  s.F.Mat = ReadFlags(S);
+  s.FStart = s.F;
+  s.Ran = 0;
+  s.RIPStart = RIP;
+  u64 rip = RIP;
+  u64 insts = 0, blocks = 0;
+
+  if (FEXCore::UncheckedLongJump::SetJump(Thread->Tier0Jump)) {
+    Thread->Tier0Active = 0;
+    WriteFlags(S, Materialize(s.F));
+    S.rip = s.RIPStart;
+    if (St) {
+      St->Faults++;
+    }
+    return {0, s.RIPStart, s.Ran != 0};
+  }
+  Thread->Tier0Active = 1;
+
+  Result Res {Thread->CurrentFrame->Pointers.DispatcherLoopTop, 0, true};
+  for (unsigned nb = 0;; nb++) {
+    if (nb) {
+      if (nb >= 64) {
+        if (St) St->Limits++;
+        break;
+      }
+      Slot* Sl = FindSlot(rip);
+      if (!Sl && St) {
+        St->Full++;
+      }
+      const u32 c = Bump(Sl);
+      if (c & COMPILED_BIT) {
+        uintptr_t Host;
+        {
+          auto lk = GuardSignalDeferringSection<std::shared_lock>(CTX->CodeInvalidationMutex, Thread);
+          Host = Thread->LookupCache->FindBlock(Thread, rip);
+        }
+        if (Host) {
+          if (St) St->Found++;
+          Res = {Host, 0, true};
+          break;
+        }
+        if (Sl) {
+          Sl->fetch_and(~COMPILED_BIT, std::memory_order_relaxed);
+        }
+      }
+      if ((c & COUNT_MASK) > T) {
+        if (St) St->Hot++;
+        Res = {0, rip, true};
+        break;
+      }
+    }
+    blocks++;
+    const Step r = Block(s, rip, insts);
+    if (r == STOP) {
+      if (St) {
+        St->Stops++;
+        const u8* p = reinterpret_cast<const u8*>(rip);
+        unsigned i = 0;
+        while (i < 15 && ((p[i] >= 0x40 && p[i] <= 0x4F) || p[i] == 0x66 || p[i] == 0xF2 || p[i] == 0xF3 || p[i] == 0xF0 || p[i] == 0x64 ||
+                          p[i] == 0x65 || p[i] == 0x2E || p[i] == 0x3E)) {
+          i++;
+        }
+        St->StopOp[p[i] == 0x0F ? 256 + p[i + 1] : p[i]]++;
+      }
+      Res = {0, rip, s.Ran != 0};
+      break;
+    }
+  }
+  Thread->Tier0Active = 0;
+  WriteFlags(S, Flags(s));
+  S.rip = rip;
+  if (St) {
+    St->Insts += insts;
+    St->Blocks += blocks;
+  }
+  return Res;
+}
+
+void DumpStats() {
+  const char* Path = secure_getenv("FEV_TIER0_STATS");
+  if (!Path || !St) {
+    return;
+  }
+  char Buf[4096];
+  int n = snprintf(Buf, sizeof(Buf), "T pid=%d threshold=%u calls=%llu insts=%llu blocks=%llu hot=%llu found=%llu stops=%llu faults=%llu limits=%llu full=%llu",
+                   getpid(), ThresholdValue, (unsigned long long)St->Calls.load(), (unsigned long long)St->Insts.load(),
+                   (unsigned long long)St->Blocks.load(), (unsigned long long)St->Hot.load(), (unsigned long long)St->Found.load(),
+                   (unsigned long long)St->Stops.load(), (unsigned long long)St->Faults.load(), (unsigned long long)St->Limits.load(),
+                   (unsigned long long)St->Full.load());
+  bool Used[512] {};
+  n += snprintf(Buf + n, sizeof(Buf) - n, " top=");
+  for (int k = 0; k < 12; k++) {
+    int Best = -1;
+    for (int i = 0; i < 512; i++) {
+      if (!Used[i] && St->StopOp[i].load() && (Best < 0 || St->StopOp[i].load() > St->StopOp[Best].load())) {
+        Best = i;
+      }
+    }
+    if (Best < 0) {
+      break;
+    }
+    Used[Best] = true;
+    n += snprintf(Buf + n, sizeof(Buf) - n, "%s%02x:%llu,", Best >= 256 ? "0f" : "", Best & 0xff, (unsigned long long)St->StopOp[Best].load());
+  }
+  n += snprintf(Buf + n, sizeof(Buf) - n, "\n");
+  int fd = open(Path, O_WRONLY | O_APPEND | O_CREAT | O_CLOEXEC, 0666);
+  if (fd >= 0) {
+    (void)!write(fd, Buf, n);
+    close(fd);
+  }
+}
+}
+
+namespace FEXCore {
+bool Tier0IsTier0PC(uint64_t PC) {
+  return Tier0::IsTier0PC(PC);
+}
+void Tier0DumpStats() {
+  Tier0::DumpStats();
+}
+}
