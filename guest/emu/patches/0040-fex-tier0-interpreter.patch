+AI bool Shift(IState& s, const Dec& d, unsigned size, unsigned cnt) {
+  const unsigned bits = size * 8;
+  cnt &= (size == 8) ? 63 : 31;
+  const unsigned op = d.Reg & 7;
+  const u64 a = GetRM(s, d, size) & SizeMask(size);
+  if (cnt == 0) {
+    return true;
+  }
+  if (op == 2 || op == 3) {
+    const u64 m = SizeMask(size), sb = SignBit(size);
+    u32 f = Flags(s);
+    u64 r = a;
+    unsigned c = cnt % (bits + 1);
+    for (unsigned i = 0; i < c; i++) {
+      const u64 cin = (f & F_CF) ? 1 : 0;
+      if (op == 2) {
+        f = (f & ~F_CF) | ((r & sb) ? F_CF : 0);
+        r = ((r << 1) | cin) & m;
+      } else {
+        f = (f & ~F_CF) | ((r & 1) ? F_CF : 0);
+        r = (r >> 1) | (cin ? sb : 0);
+      }
+    }
+    f &= ~F_OF;
+    if (op == 2 ? (!!(r & sb) != !!(f & F_CF)) : (!!(r & sb) != !!(r & (sb >> 1)))) {
+      f |= F_OF;
+    }
+    SetRM(s, d, size, r);
+    SetMat(s, f);
+    return true;
+  }
+  if (cnt >= bits && op != 0 && op != 1) {
+    return false;
+  }
+  const u64 m = SizeMask(size), sb = SignBit(size);
+  u64 r;
+  u32 f = Flags(s);
+  switch (op) {
+  case 0: {
+    const unsigned c = cnt % bits;
+    r = c ? (((a << c) | (a >> (bits - c))) & m) : a;
+    f &= ~(F_CF | F_OF);
+    if (r & 1) f |= F_CF;
+    if (!!(r & sb) != !!(f & F_CF)) f |= F_OF;
+    break;
+  }
+  case 1: {
+    const unsigned c = cnt % bits;
+    r = c ? (((a >> c) | (a << (bits - c))) & m) : a;
+    f &= ~(F_CF | F_OF);
+    if (r & sb) f |= F_CF;
+    if (!!(r & sb) != !!(r & (sb >> 1))) f |= F_OF;
+    break;
+  }
+  case 4:
+  case 6: {
+    r = (a << cnt) & m;
+    const bool c = (a >> (bits - cnt)) & 1;
+    f = ZSP(r, size) | (c ? F_CF : 0);
+    if (!!(r & sb) != c) f |= F_OF;
+    break;
+  }
+  case 5: {
+    r = a >> cnt;
+    f = ZSP(r, size) | (((a >> (cnt - 1)) & 1) ? F_CF : 0) | ((a & sb) ? F_OF : 0);
+    if (cnt != 1) f &= ~F_OF;
+    break;
+  }
+  default: {
+    const s64 sa = (s64)SExt(a, size);
+    r = (u64)(sa >> cnt) & m;
+    f = ZSP(r, size) | (((sa >> (cnt - 1)) & 1) ? F_CF : 0);
+    break;
+  }
+  }
+  SetRM(s, d, size, r);
+  SetMat(s, f);
+  return true;
+}
+
+AI Step String(IState& s, Dec& d, u8 op, u64& rip) {
+  if (OffMask & OFF_STRING) {
+    return STOP;
+  }
+  if (d.Addr32) {
+    return STOP;
+  }
+  const unsigned size = (op & 1) ? OpSize(d) : 1;
+  const s64 step = (s.S->flags[X86State::RFLAG_DF_RAW_LOC] & 0x80) ? -(s64)size : (s64)size;
+  u64* R = s.R;
+  const bool rep = d.Rep != 0;
+  const u64 segbase = d.Seg == 0x64 ? s.S->fs_cached : d.Seg == 0x65 ? s.S->gs_cached : 0;
+  switch (op) {
+  case 0xA4:
+  case 0xA5:
+    if (rep) {
+      while (R[X86State::REG_RCX]) {
+        StN(R[X86State::REG_RDI], size, LdN(R[X86State::REG_RSI] + segbase, size));
+        R[X86State::REG_RSI] += step;
+        R[X86State::REG_RDI] += step;
+        R[X86State::REG_RCX]--;
+      }
+    } else {
+      StN(R[X86State::REG_RDI], size, LdN(R[X86State::REG_RSI] + segbase, size));
+      R[X86State::REG_RSI] += step;
+      R[X86State::REG_RDI] += step;
+    }
+    break;
+  case 0xAA:
+  case 0xAB: {
+    const u64 v = R[X86State::REG_RAX];
+    if (rep) {
+      while (R[X86State::REG_RCX]) {
+        StN(R[X86State::REG_RDI], size, v);
+        R[X86State::REG_RDI] += step;
+        R[X86State::REG_RCX]--;
+      }
+    } else {
+      StN(R[X86State::REG_RDI], size, v);
+      R[X86State::REG_RDI] += step;
+    }
+    break;
+  }
+  case 0xAC:
+  case 0xAD: {
+    if (rep) {
+      return STOP;
+    }
+    const u64 v = LdN(R[X86State::REG_RSI] + segbase, size);
+    SetReg(s, X86State::REG_RAX, size, 1, v);
+    R[X86State::REG_RSI] += step;
+    break;
+  }
+  case 0xA6:
+  case 0xA7:
+  case 0xAE:
+  case 0xAF: {
+    const bool cmps = op < 0xA8;
+    for (;;) {
+      if (rep && !R[X86State::REG_RCX]) {
+        break;
+      }
+      const u64 b = LdN(R[X86State::REG_RDI], size);
+      const u64 a = cmps ? LdN(R[X86State::REG_RSI] + segbase, size) : (R[X86State::REG_RAX] & SizeMask(size));
+      SetLazy(s, L_SUB, size, a, b, a - b);
+      if (cmps) {
+        R[X86State::REG_RSI] += step;
+      }
+      R[X86State::REG_RDI] += step;
+      if (!rep) {
+        break;
+      }
+      R[X86State::REG_RCX]--;
+      const bool zf = ((a - b) & SizeMask(size)) == 0;
+      if (d.Rep == 0xF3 ? !zf : zf) {
+        break;
+      }
+    }
+    break;
+  }
+  default: return STOP;
+  }
+  rip = (u64)d.P;
+  return NEXT;
+}
+
+AI Step TwoByte(IState& s, Dec& d, u64& rip) {
