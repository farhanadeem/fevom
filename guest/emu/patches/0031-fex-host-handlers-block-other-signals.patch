 void SignalDelegator::FrontendRegisterFrontendHostSignalHandler(int Signal, bool Required) {
   // Linux signal handlers are per-process rather than per thread
   // Multiple threads could be calling in to this
   std::lock_guard lk(HostDelegatorMutex);
+  const bool NewlyRequired = Required && !HostHandlers[Signal].Required.load(std::memory_order_relaxed);
   HostHandlers[Signal].Required = Required;
   InstallHostThunk(Signal);
+  if (NewlyRequired) {
+    RefreshInstalledThunkMasks(Signal);
+  }
 }
 
+void SignalDelegator::RefreshInstalledThunkMasks(int NewSignal) {
+  for (size_t i = 1; i < HostHandlers.size(); ++i) {
+    if (i == static_cast<size_t>(NewSignal) || i == SIGKILL || i == SIGSTOP || !HostHandlers[i].Installed) {
+      continue;
+    }
+    if (HostHandlers[i].HostAction.sa_mask & (1ULL << (NewSignal - 1))) {
+      UpdateHostThunk(i);
+    }
+  }
+}
