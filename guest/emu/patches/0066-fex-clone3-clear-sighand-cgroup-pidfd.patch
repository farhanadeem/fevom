-static int CloneFork(uint32_t flags, uint64_t exit_signal) {
+#ifndef CLONE_CLEAR_SIGHAND
+#define CLONE_CLEAR_SIGHAND 0x100000000ULL
+#endif
+#ifndef CLONE_INTO_CGROUP
+#define CLONE_INTO_CGROUP 0x200000000ULL
+#endif
+
+static int CloneFork(const FEX::HLE::clone3_args* args) {
+  const uint64_t flags = args->args.flags;
+  const uint64_t exit_signal = args->args.exit_signal;
+  if (args->Type == TypeOfClone::TYPE_CLONE3 && (flags & (CLONE_PIDFD | CLONE_INTO_CGROUP))) {
+    FEX::HLE::kernel_clone3_args Host {};
+    Host.flags = flags & (CLONE_FS | CLONE_FILES | CLONE_PIDFD | CLONE_INTO_CGROUP);
+    Host.pidfd = args->args.pidfd;
+    Host.exit_signal = exit_signal;
+    Host.cgroup = args->args.cgroup;
+    return ::syscall(SYSCALL_DEF(clone3), &Host, sizeof(Host));
+  }
+  if (flags & CLONE_PIDFD) {
+    return ::syscall(SYSCALL_DEF(clone), (flags & (CLONE_FS | CLONE_FILES | CLONE_PIDFD)) | exit_signal, nullptr,
+                     reinterpret_cast<pid_t*>(args->args.parent_tid), nullptr, nullptr);
+  }
   return ::syscall(SYSCALL_DEF(clone), (flags & (CLONE_FS | CLONE_FILES)) | exit_signal, nullptr, nullptr, nullptr, nullptr);
+}
+
+static void ClearGuestSignalHandlers() {
+  auto Delegator = FEX::HLE::_SyscallHandler->GetSignalDelegator();
+  for (int Signal = 1; Signal <= 64; ++Signal) {
+    if (Signal == SIGKILL || Signal == SIGSTOP) {
+      continue;
+    }
+    FEX::HLE::GuestSigAction Old {};
+    Delegator->RegisterGuestSignalHandler(Signal, nullptr, &Old);
+    FEX::HLE::GuestSigAction New {};
+    New.sigaction_handler.handler = Old.sigaction_handler.handler == SIG_IGN ? SIG_IGN : SIG_DFL;
+    if (memcmp(&New, &Old, sizeof(New)) != 0) {
+      Delegator->RegisterGuestSignalHandler(Signal, &New, nullptr);
+    }
+  }
 }
 
