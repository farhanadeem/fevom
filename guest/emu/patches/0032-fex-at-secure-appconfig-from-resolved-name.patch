+#ifndef _WIN32
+static fextl::string SecureProgramName() {
+  const unsigned long ExecFD = getauxval(AT_EXECFD);
+  if (ExecFD == 0) {
+    return {};
+  }
+  char FDPath[64];
+  snprintf(FDPath, sizeof(FDPath), "/proc/self/fd/%lu", ExecFD);
+  char Link[PATH_MAX];
+  const ssize_t Len = readlink(FDPath, Link, sizeof(Link) - 1);
+  if (Len <= 0 || Link[0] != '/') {
+    return {};
+  }
+  const std::string_view Path(Link, Len);
+  const auto Slash = Path.rfind('/');
+  if (Slash == Path.npos || Slash + 1 >= Path.size() || Path.ends_with(" (deleted)")) {
+    return {};
+  }
+  const fextl::string Dir(Path.substr(0, Slash == 0 ? 1 : Slash));
+  const fextl::string Name(Path.substr(Slash + 1));
+  const int DirFD = open(Dir.c_str(), O_PATH | O_DIRECTORY | O_CLOEXEC);
+  if (DirFD < 0) {
+    return {};
+  }
+  struct stat DirStat {}, EntryStat {}, FileStat {};
+  const bool Trusted = fstat(DirFD, &DirStat) == 0 && DirStat.st_uid == 0 && (DirStat.st_mode & (S_IWGRP | S_IWOTH)) == 0 &&
+                       fstatat(DirFD, Name.c_str(), &EntryStat, AT_SYMLINK_NOFOLLOW) == 0 && fstat(ExecFD, &FileStat) == 0 &&
+                       EntryStat.st_dev == FileStat.st_dev && EntryStat.st_ino == FileStat.st_ino;
+  close(DirFD);
+  return Trusted ? Name : fextl::string {};
+}
+#endif
