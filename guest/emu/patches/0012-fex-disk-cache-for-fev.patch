+  static uint64_t FevomOwnBuildHash() {
+    uint64_t Hash = 0;
+    dl_iterate_phdr(
+      [](dl_phdr_info* Info, size_t, void* Data) -> int {
+        for (int i = 0; i < Info->dlpi_phnum; ++i) {
+          const auto& Ph = Info->dlpi_phdr[i];
+          if (Ph.p_type != PT_NOTE) {
+            continue;
+          }
+          const auto* P = reinterpret_cast<const uint8_t*>(Info->dlpi_addr + Ph.p_vaddr);
+          const auto* End = P + Ph.p_memsz;
+          while (P + sizeof(ElfW(Nhdr)) <= End) {
+            const auto* N = reinterpret_cast<const ElfW(Nhdr)*>(P);
+            const auto* Name = P + sizeof(*N);
+            const auto* Desc = Name + ((N->n_namesz + 3) & ~3U);
+            if (N->n_type == NT_GNU_BUILD_ID && N->n_namesz == 4 && memcmp(Name, "GNU", 4) == 0 && Desc + N->n_descsz <= End) {
+              *static_cast<uint64_t*>(Data) = XXH3_64bits(Desc, N->n_descsz);
+              return 1;
+            }
+            P = Desc + ((N->n_descsz + 3) & ~3U);
+          }
+        }
+        return 1;
+      },
+      &Hash);
+    return Hash;
+  }
+#endif
