+#ifdef __linux__
+  static bool FevomDirectoryIs(const fextl::string& Path, bool Own) {
+    fextl::string Dir = Path;
+    while (Dir.size() > 1 && Dir.back() == '/') {
+      Dir.pop_back();
+    }
+    const int FD = open(Dir.c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+    if (FD < 0) {
+      return false;
+    }
+    struct stat St {};
+    const bool Statted = fstat(FD, &St) == 0;
+    close(FD);
+    if (!Statted) {
+      return false;
+    }
+    const uid_t Me = geteuid();
+    if (Own) {
+      return St.st_uid == Me && (St.st_mode & 077) == 0;
+    }
+    if (St.st_uid != 0 && St.st_uid != Me) {
+      return false;
+    }
+    return (St.st_mode & 022) == 0 || (St.st_mode & S_ISVTX) != 0;
+  }
