+  DiskCache::DiskCache() = default;
+  DiskCache::~DiskCache() = default;
+
+  void DiskCache::Flush() {
+    if (!RWCacheDB) {
+      return;
+    }
+    std::unique_lock FlushGuard(FlushLock);
+    std::unique_lock PendingGuard(PendingLock);
+    fextl::vector<fextl::unique_ptr<CacheStoreWorkItem>> Items;
+    Items.swap(Pending);
+    PendingBytes = 0;
+    PendingGuard.unlock();
+    if (Items.empty()) {
+      return;
+    }
+#ifdef __linux__
+    if (geteuid() != OwnerUid) {
+      return;
+    }
+#endif
+    if (!RWCacheDB->BeginWrite()) {
+      return;
+    }
+    for (auto& Item : Items) {
+      Item->Run();
+    }
+    RWCacheDB->EndWrite();
+  }
+
+  void DiskCache::LockBeforeFork() {
+    FlushLock.lock();
+    PendingLock.lock();
+    IndexLock.lock();
+    MemoryLRULock.lock();
+  }
+
+  void DiskCache::UnlockAfterFork(bool Child) {
+    if (Child) {
+      Pending.clear();
+      PendingBytes = 0;
+    }
+    MemoryLRULock.unlock();
+    IndexLock.unlock();
+    PendingLock.unlock();
+    FlushLock.unlock();
+  }
