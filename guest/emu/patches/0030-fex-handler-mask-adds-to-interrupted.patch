+uint64_t SignalDelegator::RequiredSignalMask() const {
+  uint64_t Mask {};
+  for (size_t i = 0; i < MAX_SIGNALS; ++i) {
+    if (HostHandlers[i + 1].Required.load(std::memory_order_relaxed)) {
+      Mask |= 1ULL << i;
+    }
+  }
+  return Mask;
+}
+
+uint64_t SignalDelegator::DeferredFrameSignals(const FEX::HLE::ThreadStateObject* ThreadObject) {
+  uint64_t Mask {};
+  for (const auto& Frame : ThreadObject->SignalInfo.DeferredSignalFrames) {
+    Mask |= 1ULL << (Frame.Signal - 1);
+  }
+  return Mask;
+}
