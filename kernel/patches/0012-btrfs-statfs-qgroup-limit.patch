diff --git a/fs/btrfs/qgroup.c b/fs/btrfs/qgroup.c
--- a/fs/btrfs/qgroup.c
+++ b/fs/btrfs/qgroup.c
@@ -3,6 +3,7 @@
  * Copyright (C) 2011 STRATO.  All rights reserved.
  */
 
+#include <linux/moduleparam.h>
 #include <linux/sched.h>
 #include <linux/pagemap.h>
 #include <linux/writeback.h>
@@ -3661,7 +3662,57 @@
 	spin_unlock(&fs_info->qgroup_lock);
 	return ret;
 }
+
+static bool btrfs_statfs_qgroup_limit = true;
+module_param_named(statfs_qgroup_limit, btrfs_statfs_qgroup_limit, bool, 0644);
+MODULE_PARM_DESC(statfs_qgroup_limit,
+		 "statfs reports the referenced-size limits of a subvolume's qgroups as its size and free space (default: Y)");
+
+void btrfs_qgroup_statfs(struct btrfs_root *root, u64 *total, u64 *free, u64 *avail)
+{
+	struct btrfs_fs_info *fs_info = root->fs_info;
+	struct btrfs_qgroup *qgroup;
+	LIST_HEAD(qgroup_list);
 
+	if (!READ_ONCE(btrfs_statfs_qgroup_limit))
+		return;
+
+	if (!btrfs_qgroup_enabled(fs_info) || !btrfs_is_fstree(btrfs_root_id(root)))
+		return;
+
+	spin_lock(&fs_info->qgroup_lock);
+	if (!fs_info->quota_root)
+		goto out;
+
+	qgroup = find_qgroup_rb(fs_info, btrfs_root_id(root));
+	if (!qgroup)
+		goto out;
+
+	qgroup_iterator_add(&qgroup_list, qgroup);
+	list_for_each_entry(qgroup, &qgroup_list, iterator) {
+		struct btrfs_qgroup_list *glist;
+
+		if (qgroup->lim_flags & BTRFS_QGROUP_LIMIT_MAX_RFER) {
+			const u64 used = qgroup_rsv_total(qgroup) + (s64)qgroup->rfer;
+			u64 left = 0;
+
+			if (used < qgroup->max_rfer)
+				left = qgroup->max_rfer - used;
+
+			*total = min(*total, qgroup->max_rfer);
+			*free = min(*free, left);
+			*avail = min(*avail, left);
+		}
+
+		list_for_each_entry(glist, &qgroup->groups, next_group)
+			qgroup_iterator_add(&qgroup_list, glist->group);
+	}
+
+out:
+	qgroup_iterator_clean(&qgroup_list);
+	spin_unlock(&fs_info->qgroup_lock);
+}
+
 /*
