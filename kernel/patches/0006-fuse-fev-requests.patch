+	args.opcode = FUSE_RELEASE;
+	args.nodeid = get_node_id(inode);
+	args.in_numargs = 1;
+	args.in_args[0].size = sizeof(inarg);
+	args.in_args[0].value = &inarg;
+	args.force = true;
+	args.nocreds = true;
+	fuse_simple_request(get_fuse_mount(inode), &args);
+}
