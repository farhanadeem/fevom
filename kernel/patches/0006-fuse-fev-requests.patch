+bool fuse_fev_pin(struct inode *inode, u64 *fh)
+{
+	struct fuse_open_out out;
+
+	if (!IS_ENABLED(CONFIG_FUSE_FEV_CACHE) || !inode ||
+	    !S_ISREG(inode->i_mode) ||
+	    !atomic_read(&get_fuse_inode(inode)->fev_free))
+		return false;
+	if (fuse_send_open(get_fuse_mount(inode), get_node_id(inode), O_RDONLY,
+			   FUSE_OPEN, &out))
+		return false;
+	*fh = out.fh;
+	return true;
+}
