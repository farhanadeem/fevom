+#ifdef CONFIG_ARM64_MEMORY_MODEL_CONTROL
+static DEFINE_PER_CPU(u64, actlr_now);
+
+void cpu_enable_tso_apple(const struct arm64_cpu_capabilities *__unused)
+{
+	u64 actlr = read_sysreg(actlr_el1);
+
+	if (actlr & ACTLR_APPLE_TSO) {
+		actlr &= ~ACTLR_APPLE_TSO;
+		write_sysreg(actlr, actlr_el1);
 	}
+	__this_cpu_write(actlr_now, actlr);
+}
+
+static void mem_model_thread_switch(struct task_struct *next)
+{
+	u64 now, want;
+
+	if (!alternative_has_cap_unlikely(ARM64_HAS_TSO_APPLE))
+		return;
+	if (next->flags & (PF_KTHREAD | PF_IDLE | PF_USER_WORKER))
+		return;
+	now = __this_cpu_read(actlr_now);
+	want = (now & ~ACTLR_APPLE_TSO) | next->thread.actlr_tso;
+	if (likely(want == now))
+		return;
+	write_sysreg(want, actlr_el1);
+	__this_cpu_write(actlr_now, want);
 }
 
+static void mem_model_set_current(u64 tso)
+{
+	current->thread.actlr_tso = tso;
+	preempt_disable();
+	mem_model_thread_switch(current);
+	preempt_enable();
+}
+
+int arch_prctl_mem_model_get(struct task_struct *t)
+{
+	if (!alternative_has_cap_unlikely(ARM64_HAS_TSO_APPLE))
+		return -EINVAL;
+	return t->thread.actlr_tso ? PR_SET_MEM_MODEL_TSO : PR_SET_MEM_MODEL_DEFAULT;
+}
+
+int arch_prctl_mem_model_set(struct task_struct *t, unsigned long val)
+{
+	if (!alternative_has_cap_unlikely(ARM64_HAS_TSO_APPLE))
+		return -EINVAL;
+	switch (val) {
+	case PR_SET_MEM_MODEL_TSO:
+		mem_model_set_current(ACTLR_APPLE_TSO);
+		return 0;
+	case PR_SET_MEM_MODEL_DEFAULT:
+		mem_model_set_current(0);
+		return 0;
+	}
+	return -EINVAL;
+}
+#else
+static inline void mem_model_thread_switch(struct task_struct *next)
+{
+}
+static inline void mem_model_set_current(u64 tso)
+{
+}
+#endif
