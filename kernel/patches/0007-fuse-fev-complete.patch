+
+#define FUSE_FEV_NAMES_BITS	1920
+
+struct fuse_fev_names {
+	u64 until;
+	int epoch;
+	bool complete;
+	unsigned long bits[BITS_TO_LONGS(FUSE_FEV_NAMES_BITS)];
+};
+
+static bool fuse_fev_name_bits(const unsigned char *name, unsigned int len,
+				 unsigned int *a, unsigned int *b)
+{
+	u64 h = 0xcbf29ce484222325ULL;
+	unsigned int i;
+
+	for (i = 0; i < len; i++) {
+		unsigned char c = name[i];
+
+		if (c & 0x80)
+			return false;
+		if (c >= 'A' && c <= 'Z')
+			c |= 0x20;
+		h = (h ^ c) * 0x100000001b3ULL;
+	}
+	*a = (u32)h % FUSE_FEV_NAMES_BITS;
+	*b = (u32)(h >> 32) % FUSE_FEV_NAMES_BITS;
+	return true;
+}
+
+static struct fuse_fev_names *fuse_fev_names(struct inode *dir)
+{
+	struct fuse_fev_names *n;
+
+	if (!IS_ENABLED(CONFIG_FUSE_FEV_CACHE))
+		return NULL;
+	n = READ_ONCE(get_fuse_inode(dir)->fev_names);
+	if (!n || !READ_ONCE(n->complete))
+		return NULL;
+	return n;
 }
 
+void fuse_fev_dir_incomplete(struct inode *dir)
+{
+	struct fuse_inode *fi = get_fuse_inode(dir);
+
+	if (!IS_ENABLED(CONFIG_FUSE_FEV_CACHE))
+		return;
+	spin_lock(&fi->lock);
+	if (fi->fev_names)
+		WRITE_ONCE(fi->fev_names->complete, false);
+	spin_unlock(&fi->lock);
+}
+
+static void fuse_fev_name_made(struct inode *dir, const struct qstr *name)
+{
+	struct fuse_fev_names *n = fuse_fev_names(dir);
+	unsigned int a, b;
+
+	if (!n)
+		return;
+	if (!fuse_fev_name_bits(name->name, name->len, &a, &b)) {
+		fuse_fev_dir_incomplete(dir);
+		return;
+	}
+	set_bit(a, n->bits);
+	set_bit(b, n->bits);
+}
+
+static bool fuse_fev_absent(struct inode *dir, const struct qstr *name)
+{
+	struct fuse_fev_names *n = fuse_fev_names(dir);
+	unsigned int a, b;
+
+	if (!n || !name->len || name->len > FUSE_FEV_NAME_MAX)
+		return false;
+	if (n->epoch != atomic_read(&get_fuse_conn(dir)->epoch) ||
+	    time_after64(get_jiffies_64(), n->until))
+		return false;
+	if (!fuse_fev_name_bits(name->name, name->len, &a, &b))
+		return false;
+	return !(test_bit(a, n->bits) && test_bit(b, n->bits));
+}
+
+void fuse_fev_name_listed(struct inode *dir, const char *name,
+			    unsigned int len)
+{
+	struct fuse_fev_names *n = fuse_fev_names(dir);
+	unsigned int a, b;
+
+	if (!n || (len == 1 && name[0] == '.') ||
+	    (len == 2 && name[0] == '.' && name[1] == '.'))
+		return;
+	if (!fuse_fev_name_bits(name, len, &a, &b) ||
+	    !(test_bit(a, n->bits) && test_bit(b, n->bits)))
+		fuse_fev_dir_incomplete(dir);
+}
+
+static void fuse_fev_dir_made(struct fuse_conn *fc, struct inode *inode,
+				struct fuse_entry_out *o, int epoch, int records)
+{
+	struct fuse_inode *fi = get_fuse_inode(inode);
+	struct fuse_fev_names *n;
+
+	if (!IS_ENABLED(CONFIG_FUSE_FEV_CACHE) || !fc->fev_complete ||
+	    !(o->attr.flags & FUSE_ATTR_COMPLETE) || !S_ISDIR(inode->i_mode))
+		return;
+	n = kzalloc(sizeof(*n), GFP_KERNEL);
+	if (!n)
+		return;
+	n->until = fuse_time_to_jiffies(o->entry_valid, o->entry_valid_nsec);
+	n->epoch = epoch;
+	n->complete = true;
+	spin_lock(&fi->lock);
+	if (!fi->fev_names && atomic_read(&fc->fev_records) == records) {
+		WRITE_ONCE(fi->fev_names, n);
+		n = NULL;
+	}
+	spin_unlock(&fi->lock);
+	kfree(n);
+}
