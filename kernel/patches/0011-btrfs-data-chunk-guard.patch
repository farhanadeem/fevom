+static unsigned int btrfs_metadata_overcommit_guard = 1;
+
+static int metadata_overcommit_guard_set(const char *val, const struct kernel_param *kp)
+{
+	return param_set_uint_minmax(val, kp, 0, 1);
+}
+
+static const struct kernel_param_ops metadata_overcommit_guard_ops = {
+	.set = &metadata_overcommit_guard_set,
+	.get = &param_get_uint,
+};
+
+module_param_cb(metadata_overcommit_guard, &metadata_overcommit_guard_ops,
+		&btrfs_metadata_overcommit_guard, 0644);
+MODULE_PARM_DESC(metadata_overcommit_guard,
+		 "Refuse a data chunk that would take unallocated space overcommitted metadata reservations are counted against");
+
+static inline bool btrfs_metadata_overcommit_guard_on(void)
+{
+	return READ_ONCE(btrfs_metadata_overcommit_guard) != 0;
+}
+
+static atomic_long_t btrfs_metadata_overcommit_guard_refusals;
+
+static int metadata_overcommit_guard_refusals_get(char *buf, const struct kernel_param *kp)
+{
+	return sysfs_emit(buf, "%ld\n",
+			  atomic_long_read(&btrfs_metadata_overcommit_guard_refusals));
+}
+
+static const struct kernel_param_ops metadata_overcommit_guard_refusals_ops = {
+	.get = &metadata_overcommit_guard_refusals_get,
+};
+
+module_param_cb(metadata_overcommit_guard_refusals,
+		&metadata_overcommit_guard_refusals_ops, NULL, 0444);
+MODULE_PARM_DESC(metadata_overcommit_guard_refusals,
+		 "Data chunk allocations and device shrinks refused to keep metadata reservations covered");
+
+static u64 metadata_chunk_space_unallocated(struct btrfs_fs_info *fs_info, u64 profile)
+{
+	u64 avail;
+
+	if (!btrfs_get_per_profile_avail(fs_info, profile, &avail)) {
+		avail = div_u64(atomic64_read(&fs_info->free_chunk_space),
+				btrfs_bg_type_to_factor(profile));
+	}
+	avail -= min(avail, btrfs_account_freed_device_space(fs_info, profile));
+	avail -= min_t(u64, avail, atomic64_read(&fs_info->data_chunk_pending));
+	return avail;
+}
+
+static bool unallocated_loss_strands_metadata(struct btrfs_fs_info *fs_info,
+					      u64 dev_bytes)
+{
+	struct btrfs_space_info *meta;
+	bool stranded = false;
+	u64 profile, used, avail, loss;
+
+	lockdep_assert_held(&fs_info->chunk_mutex);
+
+	if (!btrfs_metadata_overcommit_guard_on())
+		return false;
+
+	meta = btrfs_find_space_info(fs_info, BTRFS_BLOCK_GROUP_METADATA);
+	if (!meta || (meta->flags & BTRFS_BLOCK_GROUP_DATA))
+		return false;
+
+	profile = btrfs_metadata_alloc_profile(fs_info);
+	loss = dev_bytes;
+	if (fs_info->fs_devices->rw_devices == 1)
+		loss = div_u64(dev_bytes + btrfs_bg_type_to_factor(profile) - 1,
+			       btrfs_bg_type_to_factor(profile));
+
+	spin_lock(&meta->lock);
+	used = btrfs_space_info_used(meta, true);
+	if (used > meta->total_bytes) {
+		avail = metadata_chunk_space_unallocated(fs_info, profile);
+		avail -= min(avail, loss);
+		if (btrfs_is_zoned(fs_info))
+			avail = ALIGN_DOWN(avail, fs_info->zone_size);
+		stranded = used - meta->total_bytes > avail;
+	}
+	if (!stranded)
+		atomic64_set(&fs_info->data_chunk_pending, loss);
+	spin_unlock(&meta->lock);
+
+	if (stranded)
+		atomic_long_inc(&btrfs_metadata_overcommit_guard_refusals);
+	return stranded;
+}
+
+void btrfs_unallocated_loss_done(struct btrfs_fs_info *fs_info)
+{
+	struct btrfs_space_info *meta;
+
+	lockdep_assert_held(&fs_info->chunk_mutex);
+
+	if (!atomic64_read(&fs_info->data_chunk_pending))
+		return;
+	meta = btrfs_find_space_info(fs_info, BTRFS_BLOCK_GROUP_METADATA);
+	if (!meta) {
+		atomic64_set(&fs_info->data_chunk_pending, 0);
+		return;
+	}
+	spin_lock(&meta->lock);
+	atomic64_set(&fs_info->data_chunk_pending, 0);
+	spin_unlock(&meta->lock);
+}
+
+bool btrfs_data_chunk_strands_metadata(struct btrfs_fs_info *fs_info,
+				       struct btrfs_space_info *data_sinfo,
+				       u64 dev_bytes)
+{
+	if (!unallocated_loss_strands_metadata(fs_info, dev_bytes))
+		return false;
+
+	spin_lock(&data_sinfo->lock);
+	data_sinfo->full_for_metadata = true;
+	spin_unlock(&data_sinfo->lock);
+	return true;
 }
 
+bool btrfs_shrink_strands_metadata(struct btrfs_fs_info *fs_info, u64 dev_bytes)
+{
+	return unallocated_loss_strands_metadata(fs_info, dev_bytes);
+}
