+static size_t virtio_transport_bvec_fit(const struct iov_iter *iter,
+					size_t max)
+{
+	const struct bio_vec *bv = iter->bvec;
+	size_t skip = iter->iov_offset;
+	unsigned long nr = iter->nr_segs;
+	size_t n = 0;
+	int frags = 0;
+
+	for (; nr && n < max; bv++, nr--) {
+		size_t len = bv->bv_len - skip;
+		size_t off = bv->bv_offset + skip;
+
+		skip = 0;
+		while (len && n < max) {
+			size_t take = min_t(size_t, len,
+					    PAGE_SIZE - offset_in_page(off));
+
+			if (frags == MAX_SKB_FRAGS)
+				return n;
+			frags++;
+			take = min(take, max - n);
+			n += take;
+			len -= take;
+			off += take;
+		}
+	}
+	return n;
+}
