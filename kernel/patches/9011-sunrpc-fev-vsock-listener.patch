+#define SVC_VSOCK_LOWAT_MAX	(64 * 1024)
+
+static void svc_vsock_lowat(struct svc_sock *svsk, size_t n)
+{
+#if IS_REACHABLE(CONFIG_VSOCKETS)
+	struct sock *sk = svsk->sk_sk;
+
+	if (sk->sk_family != AF_VSOCK)
+		return;
+	n = clamp_t(size_t, n, 1, SVC_VSOCK_LOWAT_MAX);
+	if (READ_ONCE(sk->sk_rcvlowat) != n)
+		WRITE_ONCE(sk->sk_rcvlowat, n);
+	smp_mb();
+	if (vsock_stream_has_data(vsock_sk(sk)) >= (s64)n)
+		set_bit(XPT_DATA, &svsk->sk_xprt.xpt_flags);
+#endif
 }
 
