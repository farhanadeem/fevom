+
+static bool virtblk_window_read(struct virtio_blk *vblk,
+				struct virtio_blk_vq *vq, struct request *req)
+{
+	u64 start = (u64)blk_rq_pos(req) << SECTOR_SHIFT;
+	sector_t end = blk_rq_pos(req) + blk_rq_sectors(req);
+	unsigned int grain = READ_ONCE(fev_window_grain);
+	struct req_iterator iter;
+	struct bio_vec bv;
+	const char *src;
+
+	if (!vblk->win || req_op(req) != REQ_OP_READ)
+		return false;
+	if (blk_rq_bytes(req) > READ_ONCE(fev_window_max) ||
+	    end > vblk->win_sectors ||
+	    (grain && div_u64(start, grain) !=
+		      div_u64(start + blk_rq_bytes(req) - 1, grain))) {
+		WRITE_ONCE(vq->host_end, end);
+		return false;
+	}
+	if (blk_rq_pos(req) == READ_ONCE(vq->host_end))
+		return false;
+
+	blk_mq_start_request(req);
+	src = vblk->win + start;
+	rq_for_each_segment(bv, req, iter) {
+		memcpy_to_bvec(&bv, src);
+		src += bv.bv_len;
+	}
+	this_cpu_inc(fev_window_reads);
+	blk_mq_end_request(req, BLK_STS_OK);
+	return true;
 }
 
