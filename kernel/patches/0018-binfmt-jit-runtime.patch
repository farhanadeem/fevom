+
+static int binfmt_runtime_readlink(const char *name, char __user *buf, int bufsiz)
+{
+	struct file *file;
+	const char *number;
+	char *page, *link;
+	unsigned int fd;
+	int error;
+
+	if (strncmp(name, "/proc/self/fd/", 14))
+		return -ENOENT;
+	number = name + 14;
+	if (!*number)
+		return -ENOENT;
+	for (const char *p = number; *p; p++)
+		if (!isdigit(*p))
+			return -ENOENT;
+	if (kstrtouint(number, 10, &fd))
+		return -ENOENT;
+	file = fget_raw(fd);
+	if (!file)
+		return -ENOENT;
+	page = __getname();
+	if (!page) {
+		fput(file);
+		return -ENOMEM;
+	}
+	link = d_path(&file->f_path, page, PATH_MAX);
+	error = IS_ERR(link) ? PTR_ERR(link) :
+		readlink_copy(buf, bufsiz, link, strlen(link));
+	__putname(page);
+	fput(file);
+	return error;
+}
 
