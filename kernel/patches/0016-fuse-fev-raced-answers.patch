@@ -486,8 +486,37 @@
 	if (!fuse_fev_name_bits(name, len, &a, &b) ||
 	    !(test_bit(a, n->bits) && test_bit(b, n->bits)))
 		fuse_fev_dir_incomplete(dir);
+}
+
+void fuse_fev_dir_record(struct inode *dir)
+{
+	if (!IS_ENABLED(CONFIG_FUSE_FEV_CACHE))
+		return;
+	atomic_inc(&get_fuse_inode(dir)->fev_changes);
+	smp_mb__after_atomic();
+}
+
+int fuse_fev_dir_changes(struct inode *dir)
+{
+	if (!IS_ENABLED(CONFIG_FUSE_FEV_CACHE))
+		return 0;
+	return atomic_read(&get_fuse_inode(dir)->fev_changes);
 }
 
+void fuse_fev_raced(struct inode *dir, int changes, struct dentry *entry,
+		      struct inode *inode)
+{
+	if (!IS_ENABLED(CONFIG_FUSE_FEV_CACHE))
+		return;
+	smp_mb();
+	if (atomic_read(&get_fuse_inode(dir)->fev_changes) == changes)
+		return;
+	if (entry)
+		fuse_invalidate_entry_cache(entry);
+	if (inode)
+		fuse_invalidate_attr(inode);
+}
