{
  "method": "fileshare.bind",
  "params": {
    "targets": [
      {
        "context": "engine"
      },
      {
        "context": "machine",
        "machine": "dev"
      }
    ]
  },
  "result": {
    "bound": [
      "/Volumes"
    ],
    "unbound": [
      "/tmp"
    ],
    "machines": [
      {
        "machine": "dev",
        "bound": [
          "/Volumes"
        ],
        "unbound": []
      }
    ]
  }
}
